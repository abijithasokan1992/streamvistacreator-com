# Copy this file to .env and fill in your own values
# NEVER commit your .env file to the repository

VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=your_supabase_url_here

# OCI Object Storage (used by the client for display/reference only; signed
# operations are performed by the oracle-proxy edge function).
VITE_ORACLE_BUCKET=streamvista-studio-vault-prod
VITE_OCI_REGION=us-ashburn-1
