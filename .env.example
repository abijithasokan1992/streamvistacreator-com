# Copy this file to .env and fill in your own values.
# NEVER commit real secrets to the repository.

# Core browser-safe configuration (required — the build fails without these)
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=your_supabase_url_here

# Browser-safe payments client token (per-environment: .env.development / .env.production)
VITE_PAYMENTS_CLIENT_TOKEN=your_payments_client_token_here

# OCI Object Storage (display/reference only; signed operations use Edge Functions)
VITE_ORACLE_BUCKET=streamvista-studio-vault-prod
VITE_OCI_REGION=us-ashburn-1

# Browser-safe analytics and messaging identifiers
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_MIXPANEL_TOKEN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_ONESIGNAL_APP_ID=

# SERVER-SIDE ONLY: configure in Supabase Edge Function secrets or Vercel server environment.
# Never prefix these with VITE_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ONESIGNAL_REST_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
HUBSPOT_ACCESS_TOKEN=
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
CLOUDFLARE_ZONE_ID=
VERCEL_PROJECT_ID=
